    {
      "name": "header-only",
      "roots": []
    },
    {
      "name": "single-rw",
      "roots": [
        {
          "name": "shadow",
          "path": "/_sbparity/shadow",
          "access": "rw"
        }
      ]
    },
    {
      "name": "disjoint-ro-rw",
      "roots": [
        {
          "name": "case_source",
          "path": "/_sbparity/case-source",

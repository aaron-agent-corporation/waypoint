{
  "name": "@waypoint/core",
  "version": "0.1.0",
  "private": true,
  "description": "Waypoint \u2014 host-agnostic lifecycle + workflow execution runtime. Mission Control is its first host/adapter.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "cli": "node packages/waypoint-cli/src/bin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke:folder-host": "node scripts/folder-host-smoke.mjs",
    "smoke:firmvault-folder": "node scripts/firmvault-folder-smoke.mjs",
    "smoke:firmvault-bootstrap": "node scripts/firmvault-bootstrap-smoke.mjs",
    "smoke:firmvault-document-ingestion": "node scripts/firmvault-document-ingestion-smoke.mjs",
    "smoke:firmvault-lifecycle-simulation": "node scripts/firmvault-lifecycle-simulation-smoke.mjs",
    "smoke:firmvault-staged-guidance": "node scripts/firmvault-staged-case-guidance-smoke.mjs",
    "smoke:firmvault-completed-case-replay": "node scripts/firmvault-completed-case-replay.mjs",
    "build": "tsc -p tsconfig.build.json && node scripts/stage-package-builds.mjs",
    "clean": "rm -rf dist packages/waypoint-folder-host/dist packages/waypoint-cli/dist",
    "prepack": "pnpm clean && pnpm build",
    "verify:built-imports": "node scripts/verify-built-package-imports.mjs",
    "smoke:install": "node scripts/local-install-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "yaml": "^2.6.1"
  },
  "packageManager": "pnpm@10.2.1",
  "files": [
    "dist",
    "docs",
    "quests",
    "recipes",
    "third_party/gsd",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
